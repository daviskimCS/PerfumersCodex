# ── Supabase ────────────────────────────────────────────────────────────────
# Use NEW-style API keys (sb_publishable_... / sb_secret_...).
# Legacy anon/service_role JWT keys are deprecated end of 2026 — don't use them.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (account deletion, admin tasks). Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute base for canonical URLs and Open Graph tags (app/layout.tsx
# metadataBase). Falls back to http://localhost:3000 when unset — set it in
# Vercel, or og:url ships pointing at localhost.
NEXT_PUBLIC_SITE_URL=https://perfumerscodex.com

# ── Keep-alive cron (optional) ──────────────────────────────────────────────
# Vercel Cron calls /api/keep-alive once a day (vercel.json) so the Supabase
# free tier never pauses the project. Vercel sends this value as a bearer
# token; the route refuses every request while it is unset. Production only.
# Any long random string (`openssl rand -hex 32`).
# CRON_SECRET=

# ── Bot check on the sign-in forms (optional) ───────────────────────────────
# Cloudflare Turnstile on sign-up, sign-in, password reset and the
# current-password check on /account. Create a Managed widget in the
# Cloudflare dashboard (hostnames: perfumerscodex.com, www.perfumerscodex.com,
# localhost). Set both or neither: with neither the forms skip the check; a
# secret with no site key refuses every sign-in.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Postgres (two connection strings, not one) ──────────────────────────────
# Pooled, port 6543, transaction mode — app runtime (lib/db, prepare:false).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Migrations only (drizzle.config.ts). Prefer the SESSION POOLER string
# (same host as DATABASE_URL, port 5432): the true direct host
# (db.<project-ref>.supabase.co) is IPv6-only, which hangs on IPv4-only
# networks. Session mode supports DDL, so migrations behave identically.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
